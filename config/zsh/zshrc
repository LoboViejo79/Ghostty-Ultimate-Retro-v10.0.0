# Yazi: al salir con q conserva el directorio navegado; Q no lo cambia.
function y() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd

    command yazi "$@" --cwd-file="$tmp"
    IFS= read -r -d '' cwd < "$tmp"
    [[ "$cwd" != "$PWD" && -d "$cwd" ]] && builtin cd -- "$cwd"
    command rm -f -- "$tmp"
}

_ghostty_pro_random_image() {
    local -a images
    images=("$HOME/.config/fastfetch/images/"*.png(N))
    if (( ${#images} )); then
        local idx=$(( RANDOM % ${#images} + 1 ))
        print -r -- "${images[$idx]}"
    fi
}

_ghostty_pro_random_quote() {
    local file="$HOME/.config/ghostty-ultimate/quotes/all.txt"
    [[ -r "$file" ]] || return 0
    local total line
    total=$(wc -l < "$file")
    (( total > 0 )) || return 0
    line=$(( RANDOM % total + 1 ))
    sed -n "${line}p" "$file"
}

ghostty_fastfetch() {
    local columnas="${COLUMNS:-$(tput cols 2>/dev/null || print 120)}"
    local filas="${LINES:-$(tput lines 2>/dev/null || print 30)}"
    local config image tmp

    # El perfil considera ancho y alto. Siempre conserva una imagen aleatoria,
    # pero reduce su tamaño cuando la ventana tiene menos espacio disponible.
    if (( columnas < 90 || filas < 24 )); then
        config="$HOME/.config/fastfetch/config-compact.jsonc"
    elif (( columnas < 145 || filas < 32 )); then
        config="$HOME/.config/fastfetch/config-medium.jsonc"
    else
        config="$HOME/.config/fastfetch/config-large.jsonc"
    fi

    image="$(_ghostty_pro_random_image)"
    command -v fastfetch >/dev/null 2>&1 || return 0
    if [[ -n "$image" ]]; then
        tmp=$(mktemp "${TMPDIR:-/tmp}/ghostty-pro-fastfetch.XXXXXX.jsonc") || return 1
        sed "s#@RANDOM_IMAGE@#${image//\/\\}#g" "$config" > "$tmp"
        fastfetch --config "$tmp"
        rm -f -- "$tmp"
    else
        # El panel sigue funcionando si el directorio de imágenes está vacío.
        fastfetch --config "$config" --logo none
    fi

    local quote="$(_ghostty_pro_random_quote)"
    if [[ -n "$quote" ]]; then
        local quote_limit=$(( columnas > 12 ? columnas - 8 : 4 ))
        if (( ${#quote} > quote_limit )); then
            quote="${quote[1,$(( quote_limit - 1 ))]}…"
        fi
        print -P "%F{141}󰌵  $quote%f"
    fi
    print
}

ff() {
    clear
    ghostty_fastfetch
}

gtheme() {
    "$HOME/.local/bin/ghostty-theme"
}

_fastfetch_inicio_ghostty() {
    add-zsh-hook -d precmd _fastfetch_inicio_ghostty
    if [[ "${TERM_PROGRAM:-}" == "ghostty" && -z "${FASTFETCH_SHOWN:-}" ]]; then
        export FASTFETCH_SHOWN=1
        ghostty_fastfetch
    fi
}
add-zsh-hook precmd _fastfetch_inicio_ghostty
