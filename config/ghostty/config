# Ghostty Ultimate for Arch Linux v9
# Configuración principal: estética Dracula, trabajo diario y administración.

command = /usr/bin/zsh

font-family = JetBrainsMono Nerd Font
font-size = 13
font-thicken = true
adjust-cell-height = 6%

theme = Dracula-Official
window-theme = ghostty
background-opacity = 0.97
background-blur = 18
window-padding-x = 14
window-padding-y = 12
window-padding-balance = true
window-decoration = auto
gtk-titlebar = true
window-width = 109
window-height = 22

cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true
scrollback-limit = 10000000
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow

shell-integration = zsh
shell-integration-features = cursor,sudo,title
split-inherit-working-directory = true
tab-inherit-working-directory = true
notify-on-command-finish = unfocused
notify-on-command-finish-action = no-bell,notify
notify-on-command-finish-after = 30s

# PORTAPAPELES
keybind = performable:ctrl+c=copy_to_clipboard
keybind = ctrl+v=paste_from_clipboard
keybind = ctrl+shift+c=copy_to_clipboard
keybind = ctrl+shift+v=paste_from_clipboard

# CREAR DIVISIONES
keybind = ctrl+alt+right=new_split:right
keybind = ctrl+alt+down=new_split:down
keybind = ctrl+alt+left=new_split:left
keybind = ctrl+alt+up=new_split:up

# MOVER EL FOCO ENTRE PANELES
keybind = ctrl+shift+left=goto_split:left
keybind = ctrl+shift+right=goto_split:right
keybind = ctrl+shift+up=goto_split:up
keybind = ctrl+shift+down=goto_split:down
keybind = ctrl+page_up=goto_split:previous
keybind = ctrl+page_down=goto_split:next

# CONTROL DE PANELES
keybind = ctrl+shift+w=close_surface
keybind = ctrl+shift+enter=toggle_split_zoom
keybind = ctrl+alt+equal=equalize_splits
keybind = ctrl+alt+shift+left=resize_split:left,20
keybind = ctrl+alt+shift+right=resize_split:right,20
keybind = ctrl+alt+shift+up=resize_split:up,20
keybind = ctrl+alt+shift+down=resize_split:down,20

# VENTANAS, PESTAÑAS Y CONFIGURACIÓN
keybind = ctrl+shift+n=new_window
keybind = ctrl+shift+t=new_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+alt+w=close_window
keybind = ctrl+shift+r=reload_config
keybind = ctrl+shift+p=toggle_command_palette

# HISTORIAL
keybind = shift+page_up=scroll_page_up
keybind = shift+page_down=scroll_page_down
keybind = ctrl+shift+home=scroll_to_top
keybind = ctrl+shift+end=scroll_to_bottom
